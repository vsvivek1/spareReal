  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {

      // A user may only write if they proved ownership of their identity:
      // either they passed phone/SMS verification (the `phoneVerified` custom
      // claim, set server-side in /api/auth/verify-otp) or they signed in with
      // Google. This blocks the bypass where anyone could call
      // createUserWithEmailAndPassword directly against the public Firebase
      // config and get a `password`-provider session with no verification.
      function verified() {
        return request.auth != null && (
          request.auth.token.phoneVerified == true ||
          request.auth.token.firebase.sign_in_provider == 'google.com'
        );
      }

      // Profiles hold phone numbers, so only the owner can read them.
      // Username login looks profiles up server-side (/api/auth/password-login).
      // isPremium is granted by hand (Admin SDK), never self-set.
      match /users/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if verified() && request.auth.uid == userId
          && request.resource.data.get('isPremium', false) == false;
        allow update: if verified() && request.auth.uid == userId
          && request.resource.data.get('isPremium', false)
             == resource.data.get('isPremium', false);
        allow delete: if verified() && request.auth.uid == userId;
      }

      match /spareListings/{listingId} {
        allow read: if true;
        allow create: if verified();
        allow update, delete: if verified() && request.auth.uid == resource.data.sellerId;
      }

      match /vehicles/{vehicleId} {
        allow read: if true;
        allow create: if verified();
        allow update, delete: if verified() && request.auth.uid == resource.data.sellerId;
      }

      match /spareRequests/{requestId} {
        allow read: if true;
        allow create: if verified();
        allow update, delete: if verified() && request.auth.uid == resource.data.requesterId;
      }

      match /sales/{saleId} {
        allow create: if verified()
          && request.auth.uid == request.resource.data.sellerId;
        allow read: if verified()
          && request.auth.uid == resource.data.sellerId;
      }

      match /workshops/{workshopId} {
        allow read: if true;
        allow create: if verified();
        allow update, delete: if verified() && request.auth.uid == resource.data.ownerId;
      }

      // Slot bookings are created only by /api/bookings (Admin SDK), which
      // enforces per-slot capacity in a transaction. The customer and the
      // service owner can read them, and either can cancel — nothing else.
      match /bookings/{bookingId} {
        allow read: if request.auth != null && (
          request.auth.uid == resource.data.customerId ||
          request.auth.uid == resource.data.ownerId
        );
        allow update: if verified() && (
            request.auth.uid == resource.data.customerId ||
            request.auth.uid == resource.data.ownerId
          )
          && resource.data.status == 'booked'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'cancelledAt']);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if verified()
          && request.auth.uid == request.resource.data.raterId
          && request.resource.data.raterId != request.resource.data.sellerId;
      }
    }
  }
