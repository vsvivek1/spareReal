  rules_version = '2';
  service cloud.firestore {
    match /databases/{database}/documents {

      match /users/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /spareListings/{listingId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
      }

      match /vehicles/{vehicleId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
      }

      match /spareRequests/{requestId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.requesterId;
      }

      match /sales/{saleId} {
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.sellerId;
        allow read: if request.auth != null
          && request.auth.uid == resource.data.sellerId;
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.raterId
          && request.resource.data.raterId != request.resource.data.sellerId;
      }
    }
  }
